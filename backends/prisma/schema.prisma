generator API {
  provider = "prisma-client"
  output   = "../api/src/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

generator DATA_SYNC_API {
  provider = "prisma-client"
  output   = "../data-sync/src/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}